{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/data/(.*)", "destination": "/data/$1" },
    { "source": "/pages/(.*)", "destination": "/pages/$1" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
